import type {
  Item,
  Party,
  Invoice,
  InvoiceItem,
  Purchase,
  Payment,
  StockMovement,
} from './types';

const now = new Date();
const daysAgo = (n: number) => {
  const d = new Date(now);
  d.setDate(d.getDate() - n);
  return d.toISOString().split('T')[0];
};

